-- Funções Otimizadas
local function EquipWeapon(text)
    if not text then return end
    local tool = plr.Backpack:FindFirstChild(text) or plr.Character:FindFirstChild(text)
    if tool and tool.Parent ~= plr.Character then
        plr.Character.Humanoid:EquipTool(tool)
    end
end

local function BringEnemy(pos)
    for _, v in pairs(workspace.Enemies:GetChildren()) do
        if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
            if (v.PrimaryPart.Position - pos).Magnitude <= 300 then
                v.PrimaryPart.CFrame = CFrame.new(pos)
                v.PrimaryPart.CanCollide = false
                v.Humanoid.WalkSpeed = 0
                v.Humanoid.JumpPower = 0
            end
        end
    end
end

-- Loop de Farm (Substituindo a lógica ruim pela do script melhor)
task.spawn(function()
    while task.wait() do
        if _G.AutoFarm or _G.AutoFarmBoss then
            pcall(function()
                local target = nil
                if _G.AutoFarmBoss then
                    target = workspace.Enemies:FindFirstChild(_G.SelectedBoss) or workspace.Bosses:FindFirstChild(_G.SelectedBoss)
                else
                    -- Lógica de Level Farm (Simplificada para integração)
                    for _, v in pairs(workspace.Enemies:GetChildren()) do
                        if v:FindFirstChild("Humanoid") and v.Humanoid.Health > 0 then
                            target = v
                            break
                        end
                    end
                end

                if target and target:FindFirstChild("HumanoidRootPart") then
                    EquipWeapon(_G.SelectWeapon)
                    local targetCFrame = target.HumanoidRootPart.CFrame
                    
                    -- Noclip & Position (Lógica superior do script melhor)
                    plr.Character.HumanoidRootPart.CFrame = targetCFrame * CFrame.new(0, 20, 0)
                    BringEnemy(target.HumanoidRootPart.Position)
                    
                    -- Auto Click
                    vim1:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                    vim1:SendMouseButtonEvent(0, 0, 0, false, game, 0)
                end
            end)
        end
    end
end)

