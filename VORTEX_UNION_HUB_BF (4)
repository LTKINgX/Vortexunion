-- 4. Utility Functions (Adapted from OnyxHub and Redz)
local UTILS = {}

function UTILS.getNearest(objectName, objectType, maxDistance)
    local closestObject = nil
    local minDistance = maxDistance or math.huge
    for _, v in pairs(Workspace:GetChildren()) do
        if v:IsA(objectType) and v.Name:find(objectName, 1, true) and v.PrimaryPart then
            local distance = (LocalPlayer.Character.PrimaryPart.Position - v.PrimaryPart.Position).Magnitude
            if distance < minDistance then
                minDistance = distance
                closestObject = v
            end
        end
    end
    return closestObject
end

function UTILS.getNearestHumanoid(maxDistance)
    local closestHumanoid = nil
    local minDistance = maxDistance or math.huge
    for _, v in pairs(Workspace:GetChildren()) do
        if v:FindFirstChild("Humanoid") and v:FindFirstChild("HumanoidRootPart") and v ~= LocalPlayer.Character then
            local distance = (LocalPlayer.Character.PrimaryPart.Position - v.HumanoidRootPart.Position).Magnitude
            if distance < minDistance then
                minDistance = distance
                closestHumanoid = v
            end
        end
    end
    return closestHumanoid
end

function UTILS.teleport(position)
    if LocalPlayer and LocalPlayer.Character and LocalPlayer.Character.PrimaryPart then
        LocalPlayer.Character.PrimaryPart.CFrame = CFrame.new(position)
    end
end

function UTILS.attack(target)
    if target and target:FindFirstChild("Humanoid") and target.Humanoid.Health > 0 and CommF_ then
        CommF_:InvokeServer("Attack", target.HumanoidRootPart)
    end
end

function UTILS.equipWeapon(weaponType, weaponName)
    if CommF_ then
        if weaponType == "Melee" then
            CommF_:InvokeServer("EquipMelee")
        elseif weaponType == "Sword" then
            CommF_:InvokeServer("EquipSword", weaponName)
        elseif weaponType == "Fruit" then
            CommF_:InvokeServer("EquipFruit")
        elseif weaponType == "Gun" then
            CommF_:InvokeServer("EquipGun", weaponName)
        end
    end
end

function UTILS.doQuest(questName)
    if CommF_ then
        CommF_:InvokeServer("StartQuest", questName)
    end
end

function UTILS.collectItem(item)
    if CommF_ then
        CommF_:InvokeServer("CollectItem", item)
    end
end

